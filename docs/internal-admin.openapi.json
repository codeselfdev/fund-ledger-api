          "401": {
            "description": "Invalid internal API key"
          },
          "409": {
            "description": "Stale preview or conflicting idempotency key"
          },
          "503": {
            "description": "Push or internal API not configured"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "draft",
                  "request_key",
                  "preview_token",
                  "expires_at"
                ],
                "properties": {
                  "draft": {
                    "$ref": "#/components/schemas/BroadcastDraft"
                  },
                  "request_key": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "preview_token": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/notifications/{id}/retry": {
      "post": {
        "summary": "Retry failed devices without resending accepted deliveries",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Internal-Actor",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; see INTERNAL_ADMIN_API.md for response fields"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid internal API key"
          },
          "409": {
            "description": "Stale preview or conflicting idempotency key"
          },
          "503": {
            "description": "Push or internal API not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InternalApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Api-Key"
      }
    },
    "schemas": {
      "ManualPayment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_key",
          "package",
          "billing_cycle",
          "amount",
          "method",
          "reference",
          "paid_at"
        ],
        "properties": {
          "request_key": {
            "type": "string",
            "format": "uuid"
          },
          "package": {
            "type": "string",
            "enum": [
              "starter",
              "business",
              "custom"
            ]
          },
          "billing_cycle": {
            "type": "string",
            "enum": [
              "monthly",
              "yearly"
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "default": "BDT"
          },
          "method": {
            "type": "string",
            "enum": [
              "cash",
              "bank",
              "bkash",
              "nagad",
              "card",
              "other"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "paid_at": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "SupportMessage": {
        "type": "object",
        "required": [
          "request_key"
        ],
        "properties": {
          "request_key": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string",
            "maxLength": 10000,
            "description": "Text or at least one file required"
          },
          "files": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "format": "binary"
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          }
        }
      },
      "Cleanup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "type": "boolean",
            "default": true
          },
          "confirm": {
            "type": "boolean"
          },
          "preview_token": {
            "type": "string"
          },
          "confirmation": {
            "type": "string",
            "description": "Exact DELETE <organization-slug> string from dry run"
          }
        }
      },
      "Envelope": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "BroadcastDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 65
          },
          "body": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      }
    }
  }
}
