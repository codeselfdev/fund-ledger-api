generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantPlan {
  free
  standard
  pro
}

enum Role {
  owner
  admin
  member
  cashier
  accountant
  approver
  auditor
}

enum OnboardingProgressStatus {
  in_progress
  completed
}

enum OnboardingStepStatus {
  pending
  done
  skipped
}

enum ApprovalFlowMode {
  accountant_only
  accountant_and_approver
}

enum MemberStatus {
  active
  inactive
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

enum ScheduleStatus {
  draft
  active
  closed
}

enum SchedulePurpose {
  contribution
  previous_installment
}

enum DueStatus {
  upcoming
  due
  overdue
  partial
  paid
  waived
}

enum DepositStatus {
  submitted
  pending_accountant
  pending_approver
  confirmed
  rejected
}

enum ExpenseStatus {
  draft
  pending
  approved
  paid
  rejected
}

enum ExpenseCategory {
  materials
  construction
  professional
  services
  survey
}

enum PaymentMethod {
  bkash
  nagad
  bank
  cheque
  cash
}

enum AccountType {
  bank
  cash
}

enum TransactionDirection {
  money_in  @map("in")
  money_out @map("out")
  transfer
  penalty
}

enum PenaltyType {
  onetime
  recurring
}

enum RecurringPeriod {
  weekly
  monthly
}

enum RecurringFrequency {
  weekly
  biweekly
  monthly
  bimonthly
  quarterly
  yearly
}

enum PurchaseStatus {
  ordered
  received
  cancelled
}

enum SaleStatus {
  completed
  cancelled
}

enum StockMovementType {
  purchase_received
  sale
  adjustment_increase
  adjustment_decrease
}

enum CommitmentStatus {
  pending
  kept
  kept_late
  broken
  rescheduled
  cancelled
}

enum CallOutcome {
  committed
  no_answer
  claims_paid
  dispute
}

model Tenant {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  currency      String     @default("BDT")
  plan          TenantPlan @default(free)
  branding      Json?
  contact       Json?
  penaltyPolicy Json?      @map("penalty_policy")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  users         User[]
  projects      Project[]
  members       Member[]
  onboardingProgress OnboardingProgress?
  notifications Notification[]
  activity      Activity[]

  @@map("tenants")
}

model Project {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  name          String
  totalShares   Int      @map("total_shares")
  logoFileId    String?  @map("logo_file_id")
  address       String?  @map("address")
  penaltyPolicy Json?    @map("penalty_policy")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships        ProjectMembership[]
  members            Member[]
  onboardingProgressRecords OnboardingProgress[]
  schedules          Schedule[]
  recurringSchedules RecurringSchedule[]
  dues               Due[]
  deposits           Deposit[]
  receipts           Receipt[]
  expenses           Expense[]
  accounts           Account[]
  transfers          Transfer[]
  uploads            Upload[]
  notifications      Notification[]
  activity           Activity[]
  polls              Poll[]
  notices            ProjectNotice[]
  events             ProjectEvent[]
  vendors            Vendor[]
  expenseCategoryDefs ExpenseCategoryDef[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  purchases           Purchase[]
  sales               Sale[]
  whatsappConnection  WhatsAppConnection?
  memberCallLogs      MemberCallLog[]
  paymentCommitments  PaymentCommitment[]
  memberReminders     MemberReminder[]

  @@index([tenantId])
  @@map("projects")
}

model WhatsAppConnection {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  projectId            String   @unique @map("project_id")
  wabaId                String   @map("waba_id")
  phoneNumberId         String   @map("phone_number_id")
  displayPhoneNumber    String?  @map("display_phone_number")
  verifiedName          String?  @map("verified_name")
  graphApiVersion       String   @default("v22.0") @map("graph_api_version")
  encryptedAccessToken String   @map("encrypted_access_token")
  groupId               String?  @map("group_id")
  groupName             String?  @map("group_name")
  isActive              Boolean  @default(true) @map("is_active")
  lastVerifiedAt        DateTime? @map("last_verified_at")
  createdById           String   @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("whatsapp_connections")
}

model OnboardingProgress {
  id                     String                   @id @default(cuid())
  tenantId               String                   @unique @map("tenant_id")
  projectId              String                   @map("project_id")
  status                 OnboardingProgressStatus @default(in_progress)
  organizationStepStatus OnboardingStepStatus     @default(done) @map("organization_step_status")
  accountantStepStatus   OnboardingStepStatus     @default(pending) @map("accountant_step_status")
  accountsStepStatus     OnboardingStepStatus     @default(pending) @map("accounts_step_status")
  shareholdersStepStatus OnboardingStepStatus     @default(pending) @map("shareholders_step_status")
  incomeApprovalFlow     ApprovalFlowMode         @default(accountant_and_approver) @map("income_approval_flow")
  expenseApprovalFlow    ApprovalFlowMode         @default(accountant_and_approver) @map("expense_approval_flow")
  accountantUserId       String?                  @map("accountant_user_id")
  completedAt            DateTime?                @map("completed_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("onboarding_progress")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  mobile       String
  email        String?
  passwordHash String?  @map("password_hash")
  deviceId     String?  @map("device_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships        ProjectMembership[]
  sessions           Session[]
  memberLinks        Member[]
  notifications      Notification[]      @relation("NotificationRecipient")
  actedNotifications Notification[]      @relation("NotificationActor")
  activity           Activity[]
  createdPolls       Poll[]              @relation("PollCreator")
  pollVotes          PollVote[]          @relation("PollVoter")
  createdNotices     ProjectNotice[]     @relation("ProjectNoticeCreator")
  createdEvents      ProjectEvent[]      @relation("ProjectEventCreator")
  createdCallLogs    MemberCallLog[]      @relation("MemberCallLogCreator")
  createdCommitments PaymentCommitment[]  @relation("PaymentCommitmentCreator")
  resolvedCommitments PaymentCommitment[] @relation("PaymentCommitmentResolver")
  sentReminders      MemberReminder[]     @relation("MemberReminderSender")

  @@unique([tenantId, mobile])
  @@index([tenantId])
  @@map("users")
}

model ProjectMembership {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  memberId  String?  @map("member_id")
  role      Role
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId, role])
  @@index([tenantId, projectId])
  @@index([tenantId, userId])
  @@map("project_memberships")
}

model Member {
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  projectId String       @map("project_id")
  userId    String?      @map("user_id")
  name      String
  mobile    String
  email     String?
  address   String?
  profile   Json?
  shares    Int
  status    MemberStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberships ProjectMembership[]
  dues        Due[]
  deposits    Deposit[]
  receipts    Receipt[]
  callLogs    MemberCallLog[]
  commitments PaymentCommitment[]
  reminders   MemberReminder[]

  @@unique([tenantId, projectId, mobile])
  @@index([tenantId, projectId])
  @@map("members")
}

model Invitation {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  projectId   String           @map("project_id")
  mobile      String
  role        Role
  invitedById String           @map("invited_by_id")
  status      InvitationStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  acceptedAt  DateTime?        @map("accepted_at")

  @@index([tenantId, projectId])
  @@map("invitations")
}

model OtpCode {
  id         String    @id @default(cuid())
  mobile     String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([mobile, expiresAt])
  @@map("otp_codes")
}

model Session {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  activeProjectId String?   @map("active_project_id")
  tokenHash       String    @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tokenHash])
  @@map("sessions")
}

model Schedule {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  projectId     String         @map("project_id")
  recurringScheduleId String?  @map("recurring_schedule_id")
  name          String
  unitAmount    Int?           @map("unit_amount")
  totalAmount   Int            @map("total_amount")
  dueDate       DateTime       @map("due_date")
  status        ScheduleStatus @default(active)
  purpose       SchedulePurpose @default(contribution)
  penaltyPolicy Json?          @map("penalty_policy")
  createdById   String         @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recurringSchedule  RecurringSchedule?  @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  dues               Due[]
  deposits           Deposit[]
  depositAllocations DepositAllocation[]

  @@index([tenantId, projectId, status])
  @@index([tenantId, projectId, purpose])
  @@index([tenantId, projectId, recurringScheduleId])
  @@unique([recurringScheduleId, dueDate])
  @@map("schedules")
}

model RecurringSchedule {
  id            String             @id @default(cuid())
  tenantId      String             @map("tenant_id")
  projectId     String             @map("project_id")
  name          String
  unitAmount    Int                @map("unit_amount")
  frequency     RecurringFrequency
  startsOn      DateTime           @map("starts_on")
  nextRunAt     DateTime           @map("next_run_at")
  isActive      Boolean            @default(true) @map("is_active")
  penaltyPolicy Json?              @map("penalty_policy")
  createdById   String             @map("created_by_id")
  lastRunAt     DateTime?          @map("last_run_at")
  lastRunStatus String?            @map("last_run_status")
  lastRunMessage String?           @map("last_run_message")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedules Schedule[]

  @@index([tenantId, projectId, isActive])
  @@index([tenantId, projectId, nextRunAt])
  @@map("recurring_schedules")
}

model Due {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  projectId   String    @map("project_id")
  scheduleId  String    @map("schedule_id")
  memberId    String    @map("member_id")
  amount      Int
  paidAmount  Int       @default(0) @map("paid_amount")
  waivedAmount Int      @default(0) @map("waived_amount")
  penaltyDue  Int       @default(0) @map("penalty_due")
  penaltyPaid Int       @default(0) @map("penalty_paid")
  status      DueStatus @default(due)
  dueDate     DateTime  @map("due_date")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedule    Schedule            @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  penalties   DuePenaltyEntry[]
  allocations DepositAllocation[]

  @@unique([scheduleId, memberId])
  @@index([tenantId, projectId, status])
  @@map("dues")
}

model DuePenaltyEntry {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  projectId  String      @map("project_id")
  dueId      String      @map("due_id")
  type       PenaltyType
  amount     Int
  percent    Decimal?
  reason     String?
  appliedAt  DateTime    @default(now()) @map("applied_at")
  waivedAt   DateTime?   @map("waived_at")
  waivedById String?     @map("waived_by_id")

  due Due @relation(fields: [dueId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, dueId])
  @@map("due_penalty_entries")
}

model Deposit {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  projectId      String        @map("project_id")
  scheduleId     String?       @map("schedule_id")
  memberId       String        @map("member_id")
  accountId      String?       @map("account_id")
  amount         Int
  refundedAmount Int           @default(0) @map("refunded_amount")
  method         PaymentMethod
  proofFileId    String?       @map("proof_file_id")
  reference      String?
  allocate       String?
  status         DepositStatus @default(pending_accountant)
  submittedById  String        @map("submitted_by_id")
  accountantById String?       @map("accountant_by_id")
  approverById   String?       @map("approver_by_id")
  rejectedById   String?       @map("rejected_by_id")
  rejectReason   String?       @map("reject_reason")
  confirmedAt    DateTime?     @map("confirmed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedule    Schedule?           @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  account     Account?            @relation(fields: [accountId], references: [id])
  receipt     Receipt?
  allocations DepositAllocation[]
  resolvedCommitments PaymentCommitment[] @relation("CommitmentResolvedDeposit")

  @@index([tenantId, projectId, status])
  @@index([tenantId, projectId, memberId])
  @@map("deposits")
}

model DepositAllocation {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  projectId  String   @map("project_id")
  depositId  String   @map("deposit_id")
  dueId      String   @map("due_id")
  scheduleId String   @map("schedule_id")
  amount     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  deposit  Deposit  @relation(fields: [depositId], references: [id], onDelete: Cascade)
  due      Due      @relation(fields: [dueId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([depositId, dueId])
  @@index([tenantId, projectId, dueId])
  @@map("deposit_allocations")
}

model Receipt {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  depositId String   @unique @map("deposit_id")
  memberId  String   @map("member_id")
  receiptNo String   @map("receipt_no")
  amount    Int
  method    PaymentMethod
  issuedAt  DateTime @default(now()) @map("issued_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deposit Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, projectId, receiptNo])
  @@index([tenantId, projectId, memberId])
  @@map("receipts")
}

model Expense {
  id            String          @id @default(cuid())
  tenantId      String          @map("tenant_id")
  projectId     String          @map("project_id")
  title         String
  amount        Int
  category      ExpenseCategory
  categoryDefId String?         @map("category_def_id")
  vendor        String?
  vendorId      String?         @map("vendor_id")
  vendorPhone   String?         @map("vendor_phone")
  expenseDate   DateTime?       @db.Date @map("expense_date")
  accountId     String?         @map("account_id")
  docFileId     String?         @map("doc_file_id")
  status        ExpenseStatus   @default(pending)
  createdById   String          @map("created_by_id")
  approvedById  String?         @map("approved_by_id")
  rejectedById  String?         @map("rejected_by_id")
  disbursedById String?         @map("disbursed_by_id")
  paidAccountId String?         @map("paid_account_id")
  rejectReason  String?         @map("reject_reason")
  paidAt        DateTime?       @map("paid_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorRef   Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  categoryDef ExpenseCategoryDef? @relation(fields: [categoryDefId], references: [id], onDelete: SetNull)
  account     Account?            @relation("ExpenseTargetAccount", fields: [accountId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, status])
  @@map("expenses")
}

model Vendor {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  purchases Purchase[]

  @@unique([projectId, name])
  @@index([tenantId, projectId, isActive])
  @@map("vendors")
}

model ExpenseCategoryDef {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([projectId, name])
  @@index([tenantId, projectId, isActive])
  @@map("expense_category_defs")
}

model InventoryCategory {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   InventoryItem[]

  @@unique([projectId, name])
  @@index([tenantId, projectId, isActive])
  @@map("inventory_categories")
}

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  projectId    String   @map("project_id")
  categoryId   String?  @map("category_id")
  name         String
  sku          String?
  unit         String   @default("pcs")
  photoFileId  String?  @map("photo_file_id")
  costPrice    Int      @default(0) @map("cost_price")
  sellPrice    Int      @default(0) @map("sell_price")
  quantity     Int      @default(0)
  reorderLevel Int      @default(0) @map("reorder_level")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchaseLines PurchaseItem[]
  saleLines     SaleItem[]
  movements     StockMovement[]

  @@unique([projectId, sku])
  @@index([tenantId, projectId, isActive])
  @@map("inventory_items")
}

model StockMovement {
  id            String             @id @default(cuid())
  tenantId      String             @map("tenant_id")
  projectId     String             @map("project_id")
  itemId        String             @map("item_id")
  type          StockMovementType
  quantity      Int
  quantityAfter Int                @map("quantity_after")
  referenceType String?            @map("reference_type")
  referenceId   String?            @map("reference_id")
  reason        String?
  createdById   String?            @map("created_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, itemId])
  @@map("stock_movements")
}

model Purchase {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  projectId     String         @map("project_id")
  vendorId      String?        @map("vendor_id")
  status        PurchaseStatus @default(ordered)
  totalAmount   Int            @map("total_amount")
  accountId     String?        @map("account_id")
  docFileId     String?        @map("doc_file_id")
  createdById   String         @map("created_by_id")
  receivedById  String?        @map("received_by_id")
  cancelledById String?        @map("cancelled_by_id")
  receivedAt    DateTime?      @map("received_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor  Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  account Account?       @relation("PurchaseAccount", fields: [accountId], references: [id], onDelete: SetNull)
  lines   PurchaseItem[]

  @@index([tenantId, projectId, status])
  @@map("purchases")
}

model PurchaseItem {
  id         String @id @default(cuid())
  tenantId   String @map("tenant_id")
  projectId  String @map("project_id")
  purchaseId String @map("purchase_id")
  itemId     String @map("item_id")
  quantity   Int
  unitCost   Int    @map("unit_cost")
  lineTotal  Int    @map("line_total")

  purchase Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, purchaseId])
  @@map("purchase_items")
}

model Sale {
  id            String     @id @default(cuid())
  tenantId      String     @map("tenant_id")
  projectId     String     @map("project_id")
  customerName  String?    @map("customer_name")
  status        SaleStatus @default(completed)
  totalAmount   Int        @map("total_amount")
  accountId     String     @map("account_id")
  soldById      String     @map("sold_by_id")
  cancelledById String?    @map("cancelled_by_id")
  cancelledAt   DateTime?  @map("cancelled_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  account Account    @relation("SaleAccount", fields: [accountId], references: [id])
  lines   SaleItem[]

  @@index([tenantId, projectId, status])
  @@map("sales")
}

model SaleItem {
  id        String @id @default(cuid())
  tenantId  String @map("tenant_id")
  projectId String @map("project_id")
  saleId    String @map("sale_id")
  itemId    String @map("item_id")
  quantity  Int
  unitPrice Int    @map("unit_price")
  lineTotal Int    @map("line_total")

  sale Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, saleId])
  @@map("sale_items")
}

model Account {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  projectId String      @map("project_id")
  name      String
  type      AccountType
  balance   Int         @default(0)
  isDefault Boolean     @default(false) @map("is_default")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  txns             AccountTransaction[]
  deposits         Deposit[]
  targetedExpenses Expense[]            @relation("ExpenseTargetAccount")
  purchases        Purchase[]           @relation("PurchaseAccount")
  sales            Sale[]               @relation("SaleAccount")

  @@unique([projectId, name])
  @@index([tenantId, projectId])
  @@map("accounts")
}

model Transfer {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  projectId     String   @map("project_id")
  fromAccountId String   @map("from_account_id")
  toAccountId   String   @map("to_account_id")
  amount        Int
  note          String?
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("transfers")
}

model AccountTransaction {
  id            String               @id @default(cuid())
  tenantId      String               @map("tenant_id")
  projectId     String               @map("project_id")
  accountId     String               @map("account_id")
  direction     TransactionDirection
  amount        Int
  referenceType String?              @map("reference_type")
  referenceId   String?              @map("reference_id")
  description   String?
  balanceAfter  Int                  @map("balance_after")
  createdById   String?              @map("created_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, accountId])
  @@index([tenantId, projectId, direction])
  @@map("account_transactions")
}

model Upload {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  projectId  String   @map("project_id")
  userId     String   @map("user_id")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  size       Int
  storageKey String   @map("storage_key")
  purpose    String?
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("uploads")
}

model Notification {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  projectId       String?   @map("project_id")
  recipientUserId String    @map("recipient_user_id")
  actorUserId     String?   @map("actor_user_id")
  type            String
  title           String
  body            String
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id")
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipient User     @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, recipientUserId, readAt])
  @@map("notifications")
}

model MemberCallLog {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  projectId   String      @map("project_id")
  memberId    String      @map("member_id")
  outcome     CallOutcome
  summary     String?
  calledAt    DateTime    @default(now()) @map("called_at")
  createdById String      @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member     Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy  User               @relation("MemberCallLogCreator", fields: [createdById], references: [id], onDelete: Restrict)
  commitment PaymentCommitment?

  @@index([tenantId, projectId, memberId, calledAt])
  @@map("member_call_logs")
}

model PaymentCommitment {
  id                  String           @id @default(cuid())
  tenantId            String           @map("tenant_id")
  projectId           String           @map("project_id")
  memberId            String           @map("member_id")
  callLogId           String?          @unique @map("call_log_id")
  amount              Int
  promisedDate        DateTime         @db.Date @map("promised_date")
  summary             String
  status              CommitmentStatus @default(pending)
  outstandingAtCreate Int              @map("outstanding_at_create")
  supersededById      String?          @map("superseded_by_id")
  resolvedAt          DateTime?        @map("resolved_at")
  resolvedById        String?          @map("resolved_by_id")
  resolvedDepositId   String?          @map("resolved_deposit_id")
  resolveReason       String?          @map("resolve_reason")
  createdById         String           @map("created_by_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member          Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  callLog         MemberCallLog?      @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  createdBy       User                @relation("PaymentCommitmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy      User?               @relation("PaymentCommitmentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedDeposit Deposit?            @relation("CommitmentResolvedDeposit", fields: [resolvedDepositId], references: [id], onDelete: SetNull)
  supersededBy    PaymentCommitment?  @relation("CommitmentSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes      PaymentCommitment[] @relation("CommitmentSupersession")

  @@index([tenantId, projectId, status, promisedDate])
  @@index([tenantId, projectId, memberId, createdAt])
  @@map("payment_commitments")
}

model MemberReminder {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  projectId      String   @map("project_id")
  memberId       String   @map("member_id")
  reminderDate   DateTime @db.Date @map("reminder_date")
  outstanding    Int
  deliveredCount Int      @map("delivered_count")
  sentById       String   @map("sent_by_id")
  sentAt         DateTime @default(now()) @map("sent_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sentBy  User    @relation("MemberReminderSender", fields: [sentById], references: [id], onDelete: Restrict)

  @@unique([projectId, memberId, reminderDate])
  @@index([tenantId, projectId, memberId, sentAt])
  @@map("member_reminders")
}

model Poll {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  projectId      String    @map("project_id")
  title          String
  description    String?
  expiresAt      DateTime  @map("expires_at")
  closedAt       DateTime? @map("closed_at")
  lastReminderAt DateTime? @map("last_reminder_at")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User         @relation("PollCreator", fields: [createdById], references: [id], onDelete: Restrict)
  options   PollOption[]
  votes     PollVote[]

  @@index([tenantId, projectId, expiresAt, closedAt])
  @@map("polls")
}

model PollOption {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  pollId    String   @map("poll_id")
  label     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@unique([pollId, position])
  @@index([tenantId, projectId, pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  pollId    String   @map("poll_id")
  optionId  String   @map("option_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation("PollVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([tenantId, projectId, pollId, optionId])
  @@map("poll_votes")
}

model ProjectEvent {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  projectId             String    @map("project_id")
  title                 String
  agenda                String
  place                  String
  startsAt               DateTime  @map("starts_at")
  reminderOneHourSentAt  DateTime? @map("reminder_one_hour_sent_at")
  reminderTenMinSentAt   DateTime? @map("reminder_ten_min_sent_at")
  cancelledAt            DateTime? @map("cancelled_at")
  createdById            String    @map("created_by_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ProjectEventCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, projectId, startsAt, cancelledAt])
  @@map("project_events")
}

model Activity {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  projectId   String?  @map("project_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, projectId, createdAt])
  @@map("activity")
}

model ProjectNotice {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  projectId   String   @map("project_id")
  title       String
  body        String
  imageFileId String?  @map("image_file_id")
  expiresAt   DateTime @map("expires_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User @relation("ProjectNoticeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  @@index([tenantId, projectId, expiresAt, deletedAt])
  @@map("project_notices")
}
