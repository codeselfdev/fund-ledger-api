// Owner-only subscription reminders with durable, independently retryable channels.
model SubscriptionReminderDelivery {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  notificationId String @map("notification_id")
  periodEndsAt DateTime @map("period_ends_at")
  stage String
  channel String
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  leaseUntil DateTime? @map("lease_until")
  leaseToken String? @map("lease_token")
  sentAt DateTime? @map("sent_at")
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt, leaseUntil], map: "subscription_reminder_deliveries_pending_idx")
  @@index([tenantId])
  @@map("subscription_reminder_deliveries")
}

// Current entitlement. All updates and their history event commit together.
enum SubscriptionPackage {
  free
  starter
  business
  custom
}
enum SubscriptionState {
  trial
  active
  expired
}
enum SubscriptionBillingCycle {
  monthly
  yearly
}
enum SubscriptionInvoiceState {
  open
  submitted
  approved
  rejected
}
model TenantSubscription {
  tenantId String @id @map("tenant_id")
  package SubscriptionPackage @default(free)
  status SubscriptionState
  billingCycle SubscriptionBillingCycle @map("billing_cycle")
  trialStartsAt DateTime? @map("trial_starts_at")
  trialEndsAt DateTime? @map("trial_ends_at")
  currentPeriodStartAt DateTime? @map("current_period_start_at")
  currentPeriodEndAt DateTime? @map("current_period_end_at")
  quotaResetAt DateTime? @map("quota_reset_at")
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEndAt])
  @@map("tenant_subscriptions")
}
model SubscriptionInvoice {
  receipts SubscriptionPaymentReceipt[]
  tenantId String @map("tenant_id")
  id String @default(uuid())
  package SubscriptionPackage?
  billingCycle SubscriptionBillingCycle? @map("billing_cycle")
  amount Int
  currency String
  status SubscriptionInvoiceState @default(open)
  instructions String
  issuedAt DateTime @default(now()) @map("issued_at")
  paymentReference String? @map("payment_reference")
  paymentAmount Int? @map("payment_amount")
  paymentRequestKey String? @map("payment_request_key")
  receiptId String? @map("receipt_id")
  submittedAt DateTime? @map("submitted_at")
  approvedAt DateTime? @map("approved_at")
  rejectionReason String? @map("rejection_reason")
  periodEndsAt DateTime? @map("period_ends_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@id([tenantId, id])
  @@unique([tenantId, paymentRequestKey])
  @@index([tenantId, issuedAt])
  @@index([status, submittedAt])
  @@map("subscription_invoices")
}
// Append-only events include before/after snapshots and references to their cause.
model SubscriptionHistory {
  id String @id @default(uuid())
  tenantId String @map("tenant_id")
  revision Int
  event String
  actorUserId String? @map("actor_user_id")
  actor String?
  invoiceId String? @map("invoice_id")
  paymentId String? @map("payment_id")
  previous Json?
  current Json
  createdAt DateTime @default(now()) @map("created_at")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, revision])
  @@index([tenantId, createdAt])
  @@map("subscription_history")
}
