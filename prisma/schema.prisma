generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  employee
  teacher
  owner
  admin
  member
  cashier
  accountant
  approver
  auditor
}

enum OnboardingProgressStatus {
  in_progress
  completed
}

enum OnboardingStepStatus {
  pending
  done
  skipped
}

enum ApprovalFlowMode {
  accountant_only
  accountant_and_approver
}

enum MemberStatus {
  active
  inactive
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

enum ScheduleStatus {
  draft
  active
  closed
}

enum SchedulePurpose {
  contribution
  previous_installment
}

enum DueStatus {
  upcoming
  due
  overdue
  partial
  paid
  waived
}

enum DepositStatus {
  submitted
  pending_accountant
  pending_approver
  confirmed
  rejected
}

enum ExpenseStatus {
  draft
  pending
  approved
  paid
  rejected
}

enum ExpenseCategory {
  materials
  construction
  professional
  services
  survey
}

enum PaymentMethod {
  bkash
  nagad
  bank
  cheque
  cash
}

enum AccountType {
  bank
  cash
}

enum TransactionDirection {
  money_in  @map("in")
  money_out @map("out")
  transfer
  penalty
}

enum PenaltyType {
  onetime
  recurring
}

enum RecurringPeriod {
  weekly
  monthly
}

enum RecurringFrequency {
  weekly
  biweekly
  monthly
  bimonthly
  quarterly
  yearly
}

enum PurchaseStatus {
  ordered
  received
  cancelled
}

enum SaleStatus {
  completed
  cancelled
}

enum StockMovementType {
  purchase_received
  sale
  adjustment_increase
  adjustment_decrease
}

enum CommitmentStatus {
  pending
  kept
  kept_late
  broken
  rescheduled
  cancelled
}

enum CallOutcome {
  committed
  no_answer
  claims_paid
  dispute
}

model Tenant {
  instituteNotificationDeliveryRecords InstituteNotificationDelivery[]
  instituteWriteReceiptRecords InstituteWriteReceipt[]
  instituteResultPublicationRecords InstituteResultPublication[]
  instituteMarkRecords InstituteMark[]
  instituteMarkSheetRecords InstituteMarkSheet[]
  instituteExamRecords InstituteExam[]
  instituteDocumentRecords InstituteDocument[]
  institutePostRecipientRecords InstitutePostRecipient[]
  institutePostRecords InstitutePost[]
  instituteFeeReceiptRecords InstituteFeeReceipt[]
  instituteFeePaymentRecords InstituteFeePayment[]
  instituteFeeInvoiceRecords InstituteFeeInvoice[]
  instituteFeePlanRecords InstituteFeePlan[]
  instituteLeaveRequestRecords InstituteLeaveRequest[]
  instituteAttendanceMarkRecords InstituteAttendanceMark[]
  instituteAttendanceSheetRecords InstituteAttendanceSheet[]
  instituteRoutineSlotRecords InstituteRoutineSlot[]
  instituteSubjectRecords InstituteSubject[]
  instituteTeacherAssignmentRecords InstituteTeacherAssignment[]
  instituteGuardianLinkRecords InstituteGuardianLink[]
  instituteStudentRecords InstituteStudent[]
  instituteGroupRecords InstituteGroup[]
  documentPrefix String? @map("document_prefix") @db.VarChar(3)
  documentPrefixRevision Int @default(0) @map("document_prefix_revision")
  documentSequences DocumentNumberSequence[]
  subscriptionPaymentReceipts SubscriptionPaymentReceipt[]
  platformAlerts PlatformAlert[]
  supportTickets SupportTicket[]
  appInstallations AppInstallation[]
  platformPayments PlatformPayment[]
  deletionStartedAt DateTime? @map("deletion_started_at")
  assistantReplies AssistantReply[]
  notificationCampaigns NotificationCampaign[]
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  currency      String     @default("BDT")
  branding      Json?
  contact       Json?
  subscription TenantSubscription?
  subscriptionInvoices SubscriptionInvoice[]
  subscriptionHistory SubscriptionHistory[]
  penaltyPolicy Json?      @map("penalty_policy")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  users         TenantUser[]
  projects      Project[]
  members       Member[]
  onboardingProgress OnboardingProgress?
  notifications Notification[]
  activity      Activity[]

  @@map("tenants")
}

enum ProjectType {
  institute
  fund_shares
  accounting
  billing
  construction
  payroll_pf
}

enum DepositApprovalRoute {
  accountant
  admin
}

model Project {
  payrollPortalRecords PayrollPortalRecord[]
  constructionRequisitions ConstructionRequisition[]
  constructionSupplierQuotes ConstructionSupplierQuote[]
  constructionProcurementAwards ConstructionProcurementAward[]
  constructionDeliveries ConstructionDelivery[]
  constructionPurchaseInvoices ConstructionPurchaseInvoice[]
  constructionScopeChanges ConstructionScopeChange[]
  constructionValuationMethod String @default("expense") @map("construction_valuation_method")
  constructionControlSetting ConstructionControlSetting?
  constructionControlVersions ConstructionControlVersion[]
  constructionMeasurements ConstructionMeasurement[]
  constructionValuationLayers ConstructionValuationLayer[]
  constructionValuationEntries ConstructionValuationEntry[]
  constructionReclassifications ConstructionReclassification[]
  constructionLocations ConstructionWorkLocation[]
  constructionWorkPackages ConstructionWorkPackage[]
  constructionTasks ConstructionTask[]
  constructionPhases ConstructionPhase[]
  instituteNotificationDeliveryRecords InstituteNotificationDelivery[]
  instituteWriteReceiptRecords InstituteWriteReceipt[]
  instituteResultPublicationRecords InstituteResultPublication[]
  instituteMarkRecords InstituteMark[]
  instituteMarkSheetRecords InstituteMarkSheet[]
  instituteExamRecords InstituteExam[]
  instituteDocumentRecords InstituteDocument[]
  institutePostRecipientRecords InstitutePostRecipient[]
  institutePostRecords InstitutePost[]
  instituteFeeReceiptRecords InstituteFeeReceipt[]
  instituteFeePaymentRecords InstituteFeePayment[]
  instituteFeeInvoiceRecords InstituteFeeInvoice[]
  instituteFeePlanRecords InstituteFeePlan[]
  instituteLeaveRequestRecords InstituteLeaveRequest[]
  instituteAttendanceMarkRecords InstituteAttendanceMark[]
  instituteAttendanceSheetRecords InstituteAttendanceSheet[]
  instituteRoutineSlotRecords InstituteRoutineSlot[]
  instituteSubjectRecords InstituteSubject[]
  instituteTeacherAssignmentRecords InstituteTeacherAssignment[]
  instituteGuardianLinkRecords InstituteGuardianLink[]
  instituteStudentRecords InstituteStudent[]
  instituteGroupRecords InstituteGroup[]
  payrollAttendanceConfiguration PayrollAttendanceConfiguration?
  payrollAttendances PayrollAttendance[]
  payrollAttendanceRequests PayrollAttendanceRequest[]
  payrollConfiguration PayrollConfiguration?
  payrollEmployees PayrollEmployee[]
  payrollRuns PayrollRun[]
  payrollLeaves PayrollLeave[]
  payrollBills PayrollBill[]
  payrollPFEntries PayrollPFEntry[]
  payrollOperations PayrollOperation[]
  documentSettings Json? @map("document_settings")
  contactPersons ContactPerson[]
  recurringExpenseBills RecurringExpenseBill[]
  stockManagementEnabled Boolean @default(true) @map("stock_management_enabled")
  inventoryLocations InventoryLocation[]
  businessConfiguration BusinessConfiguration?
  businessFields BusinessField[]
  businessImports BusinessImport[]
  businessTaxEntries BusinessTaxEntry[]
  shortcutPreferences ShortcutPreference[]
  fixedAssets FixedAsset[]
  fixedAssetOperations FixedAssetOperation[]
  fixedAssetEvents FixedAssetEvent[]
  fixedAssetJournals FixedAssetJournal[]
  reportSchedules ReportSchedule[]
  reportExports ReportExport[]
  telegramLinks TelegramLink[]
  telegramConnections TelegramConnection[]
  integrationPosts IntegrationPost[]
  notificationCampaigns NotificationCampaign[]
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  name          String
  totalShares   Int      @map("total_shares")
  projectType   ProjectType @default(fund_shares) @map("project_type")
  portalSettings Json? @map("portal_settings")
  commerceSettings Json? @map("commerce_settings")
  constructionSettings Json? @map("construction_settings")
  constructionCostHeads ConstructionCostHead[]
  constructionBoq ConstructionBoq[]
  constructionAllocations ConstructionCostAllocation[]
  constructionContractors ConstructionContractor[]
  constructionContracts ConstructionContract[]
  constructionRunningBills ConstructionRunningBill[]
  constructionSupplierBills ConstructionSupplierBill[]
  constructionLabor ConstructionLaborEntry[]
  constructionMaterials ConstructionMaterialEntry[]
  constructionSiteLogs ConstructionSiteLog[]
  constructionWasteLimits ConstructionWasteLimit[]
  constructionPayments ConstructionPayment[]
  constructionChanges ConstructionChangeOrder[]
  instituteSettings Json? @map("institute_settings")
  billingSettings Json? @map("billing_settings")
  billingPlans BillingPlan[]
  billingComplaints BillingComplaint[]
  billingUnits BillingUnit[]
  billingAssignments BillingAssignment[]
  billingInvoices BillingInvoice[]
  billingPayments BillingPayment[]
  billingAdjustments BillingAdjustment[]
  billingRuns BillingRun[]
  billingMessages BillingMessage[]
  incomeCategories IncomeCategory[]
  customers Customer[]
  businessDocuments BusinessDocument[]
  logoFileId    String?  @map("logo_file_id")
  address       String?  @map("address")
  penaltyPolicy Json?    @map("penalty_policy")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customRoles        ProjectRole[]
  memberships        ProjectMembership[]
  members            Member[]
  onboardingProgressRecords OnboardingProgress[]
  schedules          Schedule[]
  recurringSchedules RecurringSchedule[]
  dues               Due[]
  deposits           Deposit[]
  receipts           Receipt[]
  expenses           Expense[]
  accounts           Account[]
  transfers          Transfer[]
  uploads            Upload[]
  notifications      Notification[]
  activity           Activity[]
  polls              Poll[]
  notices            ProjectNotice[]
  events             ProjectEvent[]
  vendors            Vendor[]
  expenseCategoryDefs ExpenseCategoryDef[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  stockMovements      StockMovement[]
  purchases           Purchase[]
  sales               Sale[]
  whatsappConnection  WhatsAppConnection?
  telegramBotIdentities TelegramBotIdentity[]
  memberCallLogs      MemberCallLog[]
  paymentCommitments  PaymentCommitment[]
  memberReminders     MemberReminder[]

  @@index([tenantId])
  @@map("projects")
}

model WhatsAppConnection {
  id                   String   @id @default(cuid())
  tenantId             String   @map("tenant_id")
  projectId            String   @unique @map("project_id")
  wabaId                String   @map("waba_id")
  phoneNumberId         String   @map("phone_number_id")
  displayPhoneNumber    String?  @map("display_phone_number")
  verifiedName          String?  @map("verified_name")
  graphApiVersion       String   @default("v22.0") @map("graph_api_version")
  encryptedAccessToken String   @map("encrypted_access_token")
  groupId               String?  @map("group_id")
  groupName             String?  @map("group_name")
  managedByFundNesta    Boolean @default(false) @map("managed_by_fund_nesta")
  groupSetupStatus     String? @map("group_setup_status")
  groupSetupError      String? @map("group_setup_error")
  groupCreateRequestId String? @unique @map("group_create_request_id")
  groupInviteLink      String? @map("group_invite_link")
  isActive              Boolean  @default(true) @map("is_active")
  lastVerifiedAt        DateTime? @map("last_verified_at")
  createdById           String   @map("created_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("whatsapp_connections")
}

// Durable inbox for signed creation callbacks which may arrive before the POST response.
model WhatsAppGroupCreationEvent {
  id String @id @default(cuid())
  wabaId String @map("waba_id")
  phoneNumberId String @map("phone_number_id")
  requestId String @map("request_id")
  groupId String? @map("group_id")
  inviteLink String? @map("invite_link")
  failed Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([wabaId, phoneNumberId, requestId], map: "wa_group_creation_event_route_request_key")
  @@map("whatsapp_group_creation_events")
}

model OnboardingProgress {
  id                     String                   @id @default(cuid())
  tenantId               String                   @unique @map("tenant_id")
  projectId              String                   @map("project_id")
  status                 OnboardingProgressStatus @default(in_progress)
  organizationStepStatus OnboardingStepStatus     @default(done) @map("organization_step_status")
  accountantStepStatus   OnboardingStepStatus     @default(pending) @map("accountant_step_status")
  accountsStepStatus     OnboardingStepStatus     @default(pending) @map("accounts_step_status")
  shareholdersStepStatus OnboardingStepStatus     @default(pending) @map("shareholders_step_status")
  incomeApprovalFlow     ApprovalFlowMode         @default(accountant_and_approver) @map("income_approval_flow")
  expenseApprovalFlow    ApprovalFlowMode         @default(accountant_and_approver) @map("expense_approval_flow")
  accountantUserId       String?                  @map("accountant_user_id")
  completedAt            DateTime?                @map("completed_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("onboarding_progress")
}

model User {
  id String @id @default(cuid())
  name String
  email String? @unique
  mobile String? @unique
  passwordHash String? @map("password_hash")
  isActive Boolean @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  mobileVerifiedAt DateTime? @map("mobile_verified_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  appGuideRequests AppGuideRequest[]
  tenantMemberships TenantUser[]
  @@map("users")
}

model TenantUser {
  responsibleConstructionPhases ConstructionPhase[]
  professionalProfile Json? @map("professional_profile")
  supportTickets SupportTicket[]
  appInstallations AppInstallation[]
  shortcutPreferences ShortcutPreference[]
  notificationCampaigns NotificationCampaign[]
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  userId       String   @map("user_id")
  identity     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastLoginAt DateTime? @map("last_login_at")
  lastLoginPlatform String? @map("last_login_platform")
  lastActiveAt DateTime? @map("last_active_at")
  deviceId     String?  @map("device_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships        ProjectMembership[]
  sessions           Session[]
  memberLinks        Member[]
  notifications      Notification[]      @relation("NotificationRecipient")
  actedNotifications Notification[]      @relation("NotificationActor")
  activity           Activity[]
  createdPolls       Poll[]              @relation("PollCreator")
  pollVotes          PollVote[]          @relation("PollVoter")
  createdNotices     ProjectNotice[]     @relation("ProjectNoticeCreator")
  createdEvents      ProjectEvent[]      @relation("ProjectEventCreator")
  createdCallLogs    MemberCallLog[]      @relation("MemberCallLogCreator")
  createdCommitments PaymentCommitment[]  @relation("PaymentCommitmentCreator")
  resolvedCommitments PaymentCommitment[] @relation("PaymentCommitmentResolver")
  sentReminders      MemberReminder[]     @relation("MemberReminderSender")

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId], map: "users_tenant_id_idx")
  @@map("tenant_users")
}

model ProjectRole {
  id          String @id @default(cuid())
  tenantId    String @map("tenant_id")
  projectId   String @map("project_id")
  name        String
  nameKey     String @map("name_key")
  description String @default("")
  permissions Json
  revision    Int @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberships ProjectMembership[]
  @@unique([projectId, nameKey])
  @@index([tenantId, projectId])
  @@map("project_roles")
}

model ProjectMembership {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  memberId  String?  @map("member_id")
  role      Role
  customRoleId String? @map("custom_role_id")
  customRole ProjectRole? @relation(fields: [customRoleId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    TenantUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId, role])
  @@index([tenantId, projectId])
  @@index([tenantId, userId])
  @@map("project_memberships")
}

model Member {
  mid       String?
  id        String       @id @default(cuid())
  tenantId  String       @map("tenant_id")
  projectId String       @map("project_id")
  userId    String?      @map("user_id")
  name      String
  mobile    String
  email     String?
  address   String?
  profile   Json?
  shares    Int
  status    MemberStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        TenantUser?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberships ProjectMembership[]
  dues        Due[]
  deposits    Deposit[]
  receipts    Receipt[]
  callLogs    MemberCallLog[]
  commitments PaymentCommitment[]
  reminders   MemberReminder[]

  @@unique([tenantId, projectId, mid])
  @@index([tenantId, projectId, mobile])
  @@index([tenantId, projectId])
  @@map("members")
}

model Invitation {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  projectId   String           @map("project_id")
  mobile      String
  role        Role
  invitedById String           @map("invited_by_id")
  status      InvitationStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  acceptedAt  DateTime?        @map("accepted_at")

  @@index([tenantId, projectId])
  @@map("invitations")
}

model SmsDailyUsage {
  scope String
  day DateTime @db.Date
  count Int @default(0)

  @@id([scope, day])
  @@map("sms_daily_usage")
}

model OtpCode {
  id         String    @id @default(cuid())
  mobile     String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([mobile, expiresAt])
  @@map("otp_codes")
}

model Session {
  verifiedEmail          String? @map("verified_email")
  impersonatorUserId     String? @map("impersonator_user_id")
  impersonatorSessionId  String? @map("impersonator_session_id")
  impersonationReason    String? @map("impersonation_reason")
  impersonationPolicyHash String? @map("impersonation_policy_hash")
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  activeProjectId String?   @map("active_project_id")
  tokenHash       String    @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tokenHash])
  @@index([impersonatorSessionId])
  @@map("sessions")
}

model Schedule {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  projectId     String         @map("project_id")
  recurringScheduleId String?  @map("recurring_schedule_id")
  name          String
  unitAmount    Int?           @map("unit_amount")
  totalAmount   Int            @map("total_amount")
  dueDate       DateTime       @map("due_date")
  status        ScheduleStatus @default(active)
  purpose       SchedulePurpose @default(contribution)
  penaltyPolicy Json?          @map("penalty_policy")
  createdById   String         @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recurringSchedule  RecurringSchedule?  @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  dues               Due[]
  deposits           Deposit[]
  depositAllocations DepositAllocation[]

  @@index([tenantId, projectId, status])
  @@index([tenantId, projectId, purpose])
  @@index([tenantId, projectId, recurringScheduleId])
  @@unique([recurringScheduleId, dueDate])
  @@map("schedules")
}

model RecurringSchedule {
  id            String             @id @default(cuid())
  tenantId      String             @map("tenant_id")
  projectId     String             @map("project_id")
  name          String
  unitAmount    Int                @map("unit_amount")
  frequency     RecurringFrequency
  startsOn      DateTime           @map("starts_on")
  nextRunAt     DateTime           @map("next_run_at")
  isActive      Boolean            @default(true) @map("is_active")
  penaltyPolicy Json?              @map("penalty_policy")
  createdById   String             @map("created_by_id")
  lastRunAt     DateTime?          @map("last_run_at")
  lastRunStatus String?            @map("last_run_status")
  lastRunMessage String?           @map("last_run_message")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedules Schedule[]

  @@index([tenantId, projectId, isActive])
  @@index([tenantId, projectId, nextRunAt])
  @@map("recurring_schedules")
}

model Due {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  projectId   String    @map("project_id")
  scheduleId  String    @map("schedule_id")
  memberId    String    @map("member_id")
  amount      Int
  paidAmount  Int       @default(0) @map("paid_amount")
  waivedAmount Int      @default(0) @map("waived_amount")
  penaltyDue  Int       @default(0) @map("penalty_due")
  penaltyPaid Int       @default(0) @map("penalty_paid")
  status      DueStatus @default(due)
  dueDate     DateTime  @map("due_date")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedule    Schedule            @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  penalties   DuePenaltyEntry[]
  allocations DepositAllocation[]

  @@unique([scheduleId, memberId])
  @@index([tenantId, projectId, status])
  @@map("dues")
}

model DuePenaltyEntry {
  id         String      @id @default(cuid())
  tenantId   String      @map("tenant_id")
  projectId  String      @map("project_id")
  dueId      String      @map("due_id")
  type       PenaltyType
  amount     Int
  percent    Decimal?
  reason     String?
  appliedAt  DateTime    @default(now()) @map("applied_at")
  waivedAt   DateTime?   @map("waived_at")
  waivedById String?     @map("waived_by_id")

  due Due @relation(fields: [dueId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, dueId])
  @@map("due_penalty_entries")
}

model Deposit {
  id             String        @id @default(cuid())
  tenantId       String        @map("tenant_id")
  projectId      String        @map("project_id")
  scheduleId     String?       @map("schedule_id")
  memberId       String        @map("member_id")
  accountId      String?       @map("account_id")
  amount         Int
  refundedAmount Int           @default(0) @map("refunded_amount")
  method         PaymentMethod
  proofFileId    String?       @map("proof_file_id")
  reference      String?
  allocate       String?
  status         DepositStatus @default(pending_accountant)
  approvalRoute  DepositApprovalRoute @default(accountant) @map("approval_route")
  submittedById  String        @map("submitted_by_id")
  accountantById String?       @map("accountant_by_id")
  approverById   String?       @map("approver_by_id")
  rejectedById   String?       @map("rejected_by_id")
  rejectReason   String?       @map("reject_reason")
